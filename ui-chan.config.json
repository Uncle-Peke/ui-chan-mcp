            { "cue": "kangae", "text": "次、なにしよっかな。", "reading": "つぎ、なにしよっかな。" },
            { "cue": "normal_think", "holdMs": 2000 },
            { "cue": "smile", "holdMs": 1200 }
          ]
        },
        {
          "name": "doya",
          "weight": 10,
          "steps": [
            { "cue": "smug_hands_on_hips", "text": "ま、あたしがついてれば安心でしょ。", "reading": "ま、あたしがついてればあんしんでしょ。" },
            { "cue": "smug_arms_crossed", "holdMs": 2000 }
          ]
