      { "name": "poke_normal", "weight": 6, "minAffinity": 35, "maxAffinity": 69, "steps": [{ "cue": "emo_surprise_lo", "holdMs": 1200 }] },
      { "name": "poke_surprise", "weight": 3, "minAffinity": 35, "maxAffinity": 69, "steps": [{ "cue": "emo_surprise", "text": "わっ、びっくりした。", "reading": "わっ、びっくりした。" }] },
      { "name": "poke_shy", "weight": 6, "minAffinity": 50, "steps": [{ "cue": "self_shy", "holdMs": 1400 }] },
      { "name": "poke_ticklish", "weight": 3, "minAffinity": 50, "steps": [{ "cue": "self_shy", "text": "も〜、くすぐったいってば。", "reading": "も〜、くすぐったいってば。" }] },
      { "name": "poke_dere", "weight": 2, "minAffinity": 70, "steps": [{ "cue": "mix_joy_trust_hi", "text": "えへへ、なに〜？", "reading": "えへへ、なに〜？" }] }
