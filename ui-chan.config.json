  "affinity": {
    "$comment": "うい の好感度。セッション内のみ（永続化しない）＝毎起動 default から。MCPツール adjust_affinity で稼働中に変動。エージェントは方向(up/down)＋強さ(low/middle/high)だけ指定し、実際の増減量は非対称カーブでエンジンが算出（上げ=+b(1-a/max) 効きが鈍い、下げ=-b(1+a/max) 冷めやすく0に戻りやすい。state.ts adjustAffinity 参照）。steps はその基本量 b。bands は atLeast の最大一致でバンド決定。ういビームは beamThreshold 以上で発射",
    "default": 35,
    "min": 0,
    "max": 100,
    "beamThreshold": 65,
    "steps": { "low": 3, "middle": 6, "high": 12 },
    "bands": [
      { "atLeast": 0, "name": "cold", "note": "つれない・塩対応寄り" },
      { "atLeast": 35, "name": "normal", "note": "普通" },
      { "atLeast": 70, "name": "dere", "note": "デレ・甘め" }
    ]
  },
  "tts": {
    "enabled": true,
    "provider": "voisona-talk",
    "url": "http://127.0.0.1:32766",
    "voice_name": "",
    "language": "ja_JP",
    "app_name": "VoiSona Talk"
  },
  "lipSync": {
    "charsPerSec": 9,
    "audioPollMs": 33,
    "mouths": {
      "a": "あ",
      "e": "え",
      "i": "いー",
      "o": "お",
      "u": "ゆ",
      "n": "ん"
    }
  },
  "speech": {
    "$comment": "set_cueのduration_ms省略時の表示時間算出。テキスト駆動: baseMs + 文字数*msPerCharをminMs〜maxMsにクランプ。音声駆動: 合成音声の長さ+audioPaddingMs（audioMinMs床）",
    "baseMs": 1500,
    "msPerChar": 120,
    "minMs": 2500,
    "maxMs": 20000,
    "audioPaddingMs": 600,
    "audioMinMs": 1500
  },
  "ambient": {
    "$comment": "レンダラーのBlink（Cue外で独立ループする唯一の演出）のタイミングと、Cue切替のクロスフェード時間。cueFadeMs=0でハードカット",
    "blinkMinIntervalMs": 3500,
    "blinkMaxIntervalMs": 7000,
    "blinkDurationMs": 130,
    "cueFadeMs": 170
  },
  "cuesDir": "cues",
  "personaFile": "persona/ui-chan.md"
